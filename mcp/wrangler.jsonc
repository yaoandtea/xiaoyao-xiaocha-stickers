{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiaoyao-xiaocha-sticker-mcp",
  "main": "worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ]
}
